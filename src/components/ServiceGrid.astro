---
import ServiceCard from './ServiceCard.astro';
import FlagshipMSRDK from './FlagshipMSRDK.astro';
import servicesData from '../data/services.json';
const services = servicesData.services;
const otherServices = services.filter(s => !s.title.includes('MS-RDK'));
---

<section class="py-28 px-6 relative overflow-hidden" id="services">
    <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[300px] rounded-full" style="background: var(--wing-glow); filter: blur(120px);"></div>
    </div>

    <div class="max-w-7xl mx-auto relative z-10">
        <div class="mb-16 text-center flex flex-col items-center">
            <p class="eyebrow mb-4 stagger-reveal">永續解決方案</p>
            <h2 class="text-4xl md:text-5xl font-semibold ink leading-tight mb-5 stagger-reveal">
                精準永續，<span class="text-wing">驅動企業價值</span>
            </h2>
            <p class="ink-muted max-w-xl leading-relaxed stagger-reveal">
                透過數位化治理與專業技術支援，為各類型規模企業提供全面的永續轉型解決方案。
            </p>
        </div>

        <div class="mb-12 stagger-reveal active">
            <FlagshipMSRDK />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {otherServices.map(service => (
                <ServiceCard {...service} base="/green/services" />
            ))}
        </div>
    </div>
</section>
<style>@reference "../styles/global.css";</style>
