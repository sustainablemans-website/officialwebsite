---
interface Props {
	slug: string;
	title: string;
	description: string;
	icon: string;
	accent?: string;
	isFlagship?: boolean;
	image?: string;
	base?: string;
}

const { slug, title, description, icon, base = '/green/services' } = Astro.props;
---

<div class="group p-8 card-wing hover:-translate-y-1 transition-all duration-500 flex flex-col text-left h-full stagger-reveal active">
    <div class="w-14 h-14 rounded-xl flex items-center justify-center mb-8 transition-colors duration-500" style="background: var(--wing-surface-2); border: 1px solid var(--wing-hairline);">
        <i data-lucide={icon} class="w-6 h-6 text-wing"></i>
    </div>

    <h3 class="text-xl font-semibold ink mb-3 group-hover:text-wing transition-colors">
        {title}
    </h3>
    <p class="ink-muted text-sm leading-relaxed flex-grow">
        {description}
    </p>

    <div class="mt-8 pt-5 border-t w-full" style="border-color: var(--wing-hairline);">
        <a href={`${base}/${slug}/`} class="text-sm font-medium text-wing inline-flex items-center gap-2 group-hover:gap-3 transition-all">
            了解更多 <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
    </div>
</div>
<style>@reference "../styles/global.css";</style>
