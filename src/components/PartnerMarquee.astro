---
import partners from '../data/partners.json';
const duplicatedPartners = [...partners, ...partners];
---

<section class="py-20 overflow-hidden border-y relative" style="border-color: var(--wing-hairline);">
	<div class="max-w-7xl mx-auto px-6 mb-12 relative z-10">
		<p class="eyebrow stagger-reveal">Trusted Ecosystem · 核心合作夥伴</p>
	</div>

	<div class="relative flex items-center overflow-hidden">
		<div class="animate-marquee flex gap-16 items-center">
			{duplicatedPartners.map((partner) => (
				<div class="flex-shrink-0 transition-all duration-500 hover:scale-110 grayscale hover:grayscale-0 opacity-40 hover:opacity-100">
					<img src={partner.logo} alt={partner.name} width={partner.logoWidth} height={partner.logoHeight} class="h-9 md:h-12 w-auto object-contain" loading="lazy" decoding="async" />
				</div>
			))}
		</div>
	</div>
</section>
<style>@reference "../styles/global.css";</style>
