---
import servicesData from '../data/services.json';
const services = servicesData.services;
const msrdk = services.find(s => s.title.includes('MS-RDK'));
---

<section class="relative pt-24 pb-12 px-6 z-20">
    <div class="max-w-7xl mx-auto">
        <div class="group relative overflow-hidden card-wing p-8 md:p-12">
            <div class="absolute top-0 right-0 w-[400px] h-[400px] rounded-full -translate-y-1/2 translate-x-1/2 pointer-events-none" style="background: var(--wing-glow); filter: blur(90px);"></div>

            <div class="flex flex-col lg:flex-row items-center gap-12 relative z-10">
                <div class="flex-shrink-0 w-full lg:w-1/3 space-y-5">
                    <span class="chip-wing">旗艦技術 · Flagship</span>
                    <div class="space-y-2">
                        <p class="text-sm text-wing font-medium">日本專利 No. 6366832</p>
                        <h2 class="text-3xl md:text-4xl font-semibold ink leading-tight">
                            MS-RDK<br/><span class="text-wing">空調專利節能</span>
                        </h2>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="p-4 rounded-xl" style="background: var(--wing-surface-2); border: 1px solid var(--wing-hairline);">
                            <p class="eyebrow mb-1">減碳</p>
                            <p class="text-2xl font-semibold text-wing">-25%</p>
                        </div>
                        <div class="p-4 rounded-xl" style="background: var(--wing-surface-2); border: 1px solid var(--wing-hairline);">
                            <p class="eyebrow mb-1">安裝</p>
                            <p class="text-2xl font-semibold ink">1 MIN</p>
                        </div>
                    </div>
                </div>

                <div class="flex-grow space-y-6">
                    <p class="text-lg ink-muted leading-relaxed">
                        {msrdk?.description}
                    </p>
                    <div class="flex flex-wrap gap-3">
                        {['無電熱干擾', '陶瓷遠紅外線', '免工地施工'].map((f) => (
                            <div class="flex items-center gap-2 px-4 py-2.5 rounded-lg" style="background: var(--wing-surface-1); border: 1px solid var(--wing-hairline);">
                                <i data-lucide="check-circle" class="w-4 h-4 text-wing"></i>
                                <span class="text-sm ink-muted">{f}</span>
                            </div>
                        ))}
                    </div>
                    <div class="pt-5 border-t" style="border-color: var(--wing-hairline);">
                        <a href="/green/services/msrdk/" class="group/btn inline-flex items-center gap-2 text-wing font-medium hover:gap-3 transition-all">
                            啟動節能方案 <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<style>@reference "../styles/global.css";</style>
