---
import { getCollection } from 'astro:content';

const { limit } = Astro.props;
const allArticles = await getCollection('articles');

let articles = allArticles.map(article => {
    const cleanId = article.id
        ? article.id.split('/').pop()?.replace(/\.(md|mdx)$/, '').replace(/^\.\//, '') || 'unknown'
        : 'unknown';
    return {
        id: cleanId,
        title: article.data.title,
        category: article.data.category,
        description: article.data.description,
    };
});
if (limit) articles = articles.slice(0, limit);
---

<section class="py-28 px-6 relative overflow-hidden" id="knowledge">
    <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col md:flex-row justify-between md:items-end gap-8 mb-14">
            <div class="max-w-2xl">
                <p class="eyebrow mb-4 stagger-reveal">Insight Center · 永續知識專刊</p>
                <h2 class="text-4xl md:text-5xl font-semibold ink leading-tight stagger-reveal">
                    淨零轉型，<span class="text-wing">深度解析</span>
                </h2>
            </div>
            {limit && (
                <a href="/knowledge/" class="btn-wing-ghost stagger-reveal flex-shrink-0">
                    查看全部文章 <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
            )}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {articles.length > 0 ? articles.map((article, index) => (
                <article class="group p-8 card-wing flex flex-col justify-between stagger-reveal" style={`transition-delay: ${index * 80}ms`}>
                    <div>
                        <span class="eyebrow mb-4 inline-block"># {article.category}</span>
                        <h4 class="text-xl font-semibold ink mb-4 group-hover:text-wing transition-colors leading-snug">
                            {article.title}
                        </h4>
                        <p class="ink-muted text-sm leading-relaxed mb-8 line-clamp-3">
                            {article.description}
                        </p>
                    </div>
                    <a href={`/knowledge/${article.id}/`} class="text-sm font-medium inline-flex items-center gap-2 text-wing group-hover:gap-3 transition-all">
                        閱讀全文 <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                </article>
            )) : (
                <div class="col-span-full py-16 text-center card-wing">
                    <p class="ink-subtle text-sm">正在載入專刊內容...</p>
                </div>
            )}
        </div>
    </div>
</section>
<style>@reference "../styles/global.css";</style>
