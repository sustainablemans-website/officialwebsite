---
import site from '../data/site.json';

const links = {
	'永續轉型': [
		{ label: '空調專利節能 MS-RDK', href: '/green/services/msrdk/' },
		{ label: 'ISO 14064 碳盤查', href: '/green/services/iso14064/' },
		{ label: 'ISO 14067 碳足跡', href: '/green/services/iso14067/' },
		{ label: 'ESG 策略桌遊', href: '/green/services/esg-game/' },
		{ label: '綠色策展與印刷', href: '/green/services/green-expo/' },
	],
	'數位轉型': [
		{ label: 'AI 導入顧問', href: '/digital/services/ai-consulting/' },
		{ label: '數位建置', href: '/digital/services/digital-build/' },
		{ label: '企業自動化', href: '/digital/services/automation/' },
	],
	'公司': [
		{ label: '關於我們', href: '/about/' },
		{ label: '知識庫', href: '/knowledge/' },
		{ label: '永續影響力', href: '/impact/' },
		{ label: '聯絡我們', href: '/contact/' },
	],
	'法律與隱私': [
		{ label: '服務條款', href: '/terms/' },
		{ label: '隱私權政策', href: '/privacy/' },
	],
};
---

<footer class="border-t pt-28 pb-16 px-6 overflow-hidden relative" style="border-color: var(--wing-hairline);">
    <div class="absolute bottom-0 left-0 w-full h-2/3 pointer-events-none" style="background: radial-gradient(circle at bottom left, var(--wing-glow), transparent 70%);"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex flex-col lg:flex-row justify-between gap-16 mb-20">
            <div class="max-w-sm">
                <a href="/" class="flex items-center gap-3 mb-6 stagger-reveal">
                    <img src="/images/logo.png" alt="杉蔓有限公司" class="w-9 h-9 object-contain" />
                    <span class="text-lg font-semibold tracking-tight ink">杉蔓有限公司</span>
                </a>
                <p class="ink-muted text-sm leading-relaxed mb-6 stagger-reveal">
                    永續與數位雙軸轉型的策略夥伴。以專業顧問、創新教育與數位工程，協助企業邁向淨零與智慧營運。
                </p>
                <div class="text-sm ink-subtle space-y-1.5 mb-8 stagger-reveal">
                    <p class="flex items-center gap-2"><i data-lucide="mail" class="w-4 h-4 text-wing"></i>{site.contact.email}</p>
                    <p class="flex items-center gap-2"><i data-lucide="phone" class="w-4 h-4 text-wing"></i>{site.contact.phone}</p>
                    <p class="flex items-center gap-2"><i data-lucide="map-pin" class="w-4 h-4 text-wing"></i>{site.contact.address}</p>
                </div>
                <div class="flex gap-3 stagger-reveal">
                    <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-10 h-10 border flex items-center justify-center hover:bg-wing transition-all duration-300 group rounded-lg" style="border-color: var(--wing-hairline);">
                        <svg class="w-4 h-4 group-hover:opacity-100 transition-opacity" style="fill: var(--wing-ink-subtle);" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                    <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-10 h-10 border flex items-center justify-center hover:bg-wing transition-all duration-300 group rounded-lg" style="border-color: var(--wing-hairline);">
                        <svg class="w-4 h-4" style="fill: var(--wing-ink-subtle);" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.066.935 20.397.525 19.61.22c-.765-.296-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.055 1.17-.249 1.805-.415 2.227-.214.562-.47 1.002-.898 1.43-.43.43-.87.684-1.432.898-.422.164-1.057.36-2.227.413-1.266.057-1.646.07-4.85.07s-3.585-.015-4.85-.074c-1.17-.055-1.805-.249-2.227-.415-.562-.214-1.002-.47-1.43-.898-.43-.43-.684-.87-.898-1.432-.164-.422-.36-1.057-.413-2.227-.057-1.266-.07-1.646-.07-4.85s.016-3.585.071-4.85c.055-1.17.249-1.805.415-2.227.217-.562.477-.96.896-1.382.42-.419.819-.679 1.381-.896.422-.164 1.057-.36 2.227-.413 1.266-.057 1.646-.07 4.85-.07zM12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.88 1.44 1.44 0 000-2.88z"/></svg>
                    </a>
                    <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-10 h-10 border flex items-center justify-center hover:bg-wing transition-all duration-300 group rounded-lg" style="border-color: var(--wing-hairline);">
                        <svg class="w-4 h-4" style="fill: var(--wing-ink-subtle);" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-10 lg:gap-16">
                {Object.entries(links).map(([title, items], idx) => (
                    <div class="stagger-reveal" style={`transition-delay: ${idx * 100}ms`}>
                        <h4 class="eyebrow mb-5">{title}</h4>
                        <ul class="space-y-3">
                            {items.map(item => (
                                <li>
                                    <a href={item.href} class="text-sm ink-muted hover:text-wing transition-colors">{item.label}</a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))}
            </div>
        </div>

        <div class="pt-8 border-t flex flex-col md:flex-row justify-between items-center gap-4 stagger-reveal" style="border-color: var(--wing-hairline);">
            <span class="text-xs ink-subtle">© {new Date().getFullYear()} {site.footer.copyright}</span>
            <span class="text-xs ink-subtle">Sustainable × Digital Transformation</span>
        </div>
    </div>
</footer>
<style>@reference "../styles/global.css";</style>
