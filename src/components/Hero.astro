---
// 永續翼 Hero — 收斂字級、hairline 卡片、翼主色克制強調
---

<section class="min-h-screen flex flex-col justify-center items-center px-6 md:px-12 pt-36 pb-20 overflow-hidden relative" id="home">
    <!-- 純 CSS 背景：翼 canvas 漸層 + 柔和 radial glow + 細緻網格（無任何含文字圖片） -->
    <div class="absolute inset-0 z-0 pointer-events-none">
        <div class="absolute inset-0" style="background: radial-gradient(circle at 50% 30%, var(--wing-glow), transparent 62%);"></div>
        <div class="absolute inset-0 opacity-[0.12]" style="background-image: linear-gradient(var(--wing-hairline) 1px, transparent 1px), linear-gradient(90deg, var(--wing-hairline) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(circle at 50% 35%, black, transparent 72%); -webkit-mask-image: radial-gradient(circle at 50% 35%, black, transparent 72%);"></div>
        <div class="absolute inset-x-0 bottom-0 h-1/3" style="background: linear-gradient(to bottom, transparent, var(--wing-canvas));"></div>
    </div>

    <div class="z-10 max-w-6xl w-full stagger-reveal active">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
            <div class="space-y-7 text-left">
                <div class="chip-wing">
                    <span class="w-1.5 h-1.5 bg-wing rounded-full animate-pulse"></span>
                    永續轉型 · 碳管理 · 節能減碳
                </div>

                <h1 class="text-4xl md:text-6xl lg:text-[4.25rem] font-semibold ink leading-[1.05]">
                    以數據驅動的<br/><span class="text-wing">永續轉型</span>路徑
                </h1>

                <p class="text-lg ink-muted max-w-xl leading-relaxed">
                    結合專業顧問與數位工具，為企業打造透明、可驗證、可持續的淨零策略——從碳盤查、節能技術到永續教育，一站到位。
                </p>

                <div class="flex flex-wrap gap-3 pt-1">
                    <a href="/green/services/" class="btn-wing">探索永續服務 <i data-lucide="arrow-right" class="w-4 h-4"></i></a>
                    <a href="/about/" class="btn-wing-ghost"><i data-lucide="play-circle" class="w-4 h-4"></i> 認識杉蔓</a>
                </div>

                <div class="pt-8 border-t space-y-3" style="border-color: var(--wing-hairline);">
                    <p class="eyebrow">合作夥伴信賴</p>
                    <div class="flex gap-6 items-center opacity-50 grayscale">
                         <img src="/images/partners/EKO.webp" alt="EKO" width="143" height="93" decoding="async" class="h-6 w-auto object-contain" />
                         <img src="/images/partners/PLAB.webp" alt="PLAB" width="225" height="225" decoding="async" class="h-6 w-auto object-contain" />
                         <img src="/images/partners/願景logo-new.webp" alt="願景" width="400" height="267" decoding="async" class="h-6 w-auto object-contain" />
                    </div>
                </div>
            </div>

            <div class="relative group hidden lg:block">
                <div class="aspect-square rounded-2xl overflow-hidden card-wing relative">
                    <img src="/images/about.webp" alt="ESG 團隊願景" width="1024" height="1024" fetchpriority="high" decoding="async" class="w-full h-full object-cover transition-all duration-1000 group-hover:scale-105" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                    <div class="absolute bottom-6 left-6 right-6 p-5 rounded-xl" style="background: color-mix(in srgb, var(--wing-canvas) 55%, transparent); border: 1px solid var(--wing-hairline); backdrop-filter: blur(14px);">
                         <p class="eyebrow mb-1.5">Expert Insights</p>
                         <p class="text-base font-semibold ink leading-snug">以數據為本，賦能企業的永續決策。</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce opacity-30 text-wing">
        <i data-lucide="chevron-down" class="w-8 h-8"></i>
    </div>
</section>
<style>@reference "../styles/global.css";</style>

<script is:inline>
    setTimeout(() => {
        document.querySelectorAll('.stagger-reveal').forEach((el, index) => {
            setTimeout(() => el.classList.add('active'), index * 150);
        });
    }, 100);
</script>
