---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import site from '../data/site.json';
import { SITE_URL, organizationSchema } from '../lib/schema';

interface Props {
	title: string;
	description?: string;
	canonical?: string;
	wing?: 'green' | 'digital';
	/** 頁面專屬 JSON-LD（單一物件或陣列），由各頁面傳入 */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  // 預設依當前頁面路徑自動生成 canonical，避免全站指向同一網址
  canonical = new URL(Astro.url.pathname, SITE_URL).href,
  // 翼主題：共用頁預設綠翼；數位翼頁面傳入 'digital'
  wing = 'green',
  jsonLd
} = Astro.props;

// 頁面專屬 JSON-LD 統一轉為陣列處理
const pageJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const themeColor = wing === 'digital' ? '#5e6ad2' : '#10b981';
---

<!doctype html>
<html lang="zh-TW" data-wing={wing} class="no-js">
	<head>
		<meta charset="UTF-8" />
		<!-- JS 可用時立刻移除 no-js（stagger-reveal 的無 JS fallback 開關） -->
		<script is:inline data-astro-rerun>document.documentElement.classList.remove('no-js');</script>
		<meta name="description" content={description} />
		<meta name="keywords" content="AI 碳盤查, 淨零轉型顧問, 數位綠色雙軸轉型, 2026 永續趨勢, CBAM 應對方案, ISO 14064 輔導, MSRDK 空調節能專利, 杉蔓有限公司, Sustainable Man" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/logo-192.png" />
		<link rel="apple-touch-icon" href="/logo-192.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="杉蔓永續知識庫 RSS" href={`${SITE_URL}/rss.xml`} />
    <!-- Google Fonts: preconnect to avoid render-blocking -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&family=Inter:wght@400;500;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700;900&family=Inter:wght@400;500;700&display=swap" media="print" onload="this.media='all'" />
		<title>{title}</title>

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={`${SITE_URL}/images/og.jpg`} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonical} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={`${SITE_URL}/images/og.jpg`} />

		<!-- JSON-LD Structured Data：全站 Organization + LocalBusiness -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema())}></script>
		<!-- 頁面專屬 JSON-LD（由各頁面透過 jsonLd prop 傳入） -->
		{pageJsonLd.map((ld) => (
			<script type="application/ld+json" is:inline set:html={JSON.stringify(ld)}></script>
		))}

		<!-- Lucide: 鎖定版本 + 直接指向 UMD 檔（避免 @latest 的 CDN redirect），defer 避免阻塞渲染 -->
		<script src="https://unpkg.com/lucide@1.24.0/dist/umd/lucide.min.js" defer></script>
        <ClientRouter />
	</head>
	<body class="flex flex-col min-h-screen">
		<slot />
		<script is:inline>
			function initIcons() {
				if (window.lucide) {
					window.lucide.createIcons();
				}
			}

			function initReveals() {
				const observerOptions = { threshold: 0.1 };
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('active');
						}
					});
				}, observerOptions);
				
				document.querySelectorAll('.stagger-reveal').forEach(el => observer.observe(el));
			}

			// Initialize on first load and subsequent navigation
			document.addEventListener('astro:page-load', () => {
				initIcons();
				initReveals();
			});
			
			// Fallback for fast loading environments
			setTimeout(() => {
				initIcons();
				initReveals();
			}, 150);
		</script>
	</body>
</html>
