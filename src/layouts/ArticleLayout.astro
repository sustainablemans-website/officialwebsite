---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title, description, category, image, jsonLd } = Astro.props;
---

<Layout wing="green" title={`${title} | 杉蔓有限公司`} description={description} ogImage={image} jsonLd={jsonLd}>
	<Header wing="green" />

	<main class="pt-32 pb-20 min-h-screen">
		<article class="max-w-4xl mx-auto px-6">
			<!-- Breadcrumb -->
			<nav class="mb-12 stagger-reveal">
				<a href="/knowledge/" class="text-sm ink-subtle hover:text-wing transition-colors flex items-center gap-2">
					<i data-lucide="arrow-left" class="w-4 h-4"></i> 返回知識庫
				</a>
			</nav>

			<!-- Header Section -->
			<header class="mb-16 stagger-reveal delay-200">
				<span class="eyebrow mb-4 inline-block">
					# {category}
				</span>
				<h1 class="text-3xl md:text-5xl font-semibold tracking-tight leading-tight mb-8 ink">
					{title}
				</h1>
				<p class="text-lg ink-muted leading-relaxed border-l-2 border-wing pl-5">
					{description}
				</p>
			</header>

			<!-- Cover Image -->
			{image && (
				<figure class="mb-16 stagger-reveal delay-300 rounded-2xl overflow-hidden border" style="border-color: var(--wing-hairline);">
					<img src={image} alt={title} width="1600" height="900" fetchpriority="high" decoding="async" class="w-full h-auto object-cover" />
				</figure>
			)}

			<!-- Content Section -->
			<div class="prose prose-invert max-w-none
				prose-headings:font-semibold prose-headings:tracking-tight
				prose-h3:text-2xl prose-h3:mt-14 prose-h3:mb-6 prose-h3:text-wing
				prose-p:text-lg prose-p:leading-relaxed prose-p:mb-8
				prose-li:text-lg prose-li:mb-4
				prose-strong:font-semibold
				prose-hr:my-16
				stagger-reveal delay-400 article-body">
				<slot />
			</div>

			<!-- Footer CTA -->
			<footer class="mt-24 pt-10 border-t flex flex-col md:flex-row justify-between items-center gap-8 stagger-reveal" style="border-color: var(--wing-hairline);">
				<div>
					<h4 class="text-xl font-semibold ink mb-2">對此主題有更多疑問？</h4>
					<p class="ink-subtle text-sm">我們的顧問團隊隨時為您服務。</p>
				</div>
				<a href="/contact/" class="btn-wing">
					立即諮詢 <i data-lucide="arrow-right" class="w-4 h-4"></i>
				</a>
			</footer>
		</article>
	</main>

	<Footer />
</Layout>

<style is:global>
	@reference "../styles/global.css";

	/* 文章內文：隨翼主題換膚的克制樣式 */
	.article-body p, .article-body li { color: var(--wing-ink-muted); }
	.article-body strong { color: var(--wing-ink); }
	.prose h3 {
		border-bottom: 1px solid var(--wing-hairline);
		@apply pb-4;
	}
	.prose hr { border-color: var(--wing-hairline); }
	.prose ul, .prose ol {
		@apply list-none pl-0;
	}
	.prose li {
		@apply relative pl-8;
	}
	.prose li::before {
		content: '';
		background: var(--wing-primary);
		@apply absolute left-0 top-3 w-4 h-[2px];
	}
</style>
