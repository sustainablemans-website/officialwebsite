---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ServiceDetail from '../../../components/ServiceDetail.astro';
import servicesData from '../../../data/services.json';

export function getStaticPaths() {
    return servicesData.services.map(s => ({
        params: { slug: s.slug },
        props: { service: s }
    }));
}
const { service } = Astro.props;
---

<Layout wing="green" title={`${service.title} | 杉蔓有限公司`} description={service.description}>
    <Header wing="green" />
    <ServiceDetail service={service} base="/green/services" backLabel="返回永續服務" />
    <Footer wing="green" />
</Layout>
