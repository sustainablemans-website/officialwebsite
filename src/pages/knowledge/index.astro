---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import KnowledgeCenter from '../../components/KnowledgeCenter.astro';
import Footer from '../../components/Footer.astro';
import { collectionPageSchema } from '../../lib/schema';

const articles = await getCollection('articles', ({ data }) => !data.draft);
const jsonLd = collectionPageSchema(
	articles.map((a) => ({
		title: a.data.title,
		path: `/knowledge/${a.id.replace(/\.md$/, '').replace(/^\.\//, '')}/`
	}))
);
---

<Layout
	wing="green"
	title="永續知識庫 | 杉蔓有限公司 Sustainable Man"
	description="淨零轉型、碳管理與 ESG 趨勢的深度解析——杉蔓永續知識專刊。"
	jsonLd={jsonLd}>
	<Header wing="green" />
	<main class="pt-24">
		<KnowledgeCenter />
	</main>
	<Footer wing="green" />
</Layout>
